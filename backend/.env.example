# 4BIT VoiceCare Backend Environment Template
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key
SUPABASE_STORAGE_BUCKET=evidence
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOW_DEV_AUTH_HEADERS=false
ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3002","http://localhost:3003","http://127.0.0.1:3001","http://127.0.0.1:3002","http://127.0.0.1:3003"]
# Provider keys may belong to separate Gemini and Groq accounts.
GEMINI_API_KEY=replace-with-gemini-key
GROQ_API_KEY=replace-with-groq-key
SARVAM_API_KEY=replace-with-sarvam-key
# Optional role-specific keys override the shared provider key. Use separate
# account keys here when conversation, orchestration, and verification budgets
# or billing must remain isolated.
GEMINI_CONVERSATION_API_KEY=
GROQ_CONVERSATION_API_KEY=
GEMINI_ORCHESTRATOR_API_KEY=
GROQ_ORCHESTRATOR_API_KEY=
GEMINI_VERIFICATION_API_KEY=
GROQ_VERIFICATION_API_KEY=
AI_CONVERSATION_PROVIDERS=gemini,groq
AI_ORCHESTRATOR_PROVIDERS=gemini,groq
AI_VERIFICATION_PROVIDERS=gemini,groq
GEMINI_CONVERSATION_MODEL=configure-a-text-capable-gemini-model
GROQ_CONVERSATION_MODEL=configure-a-text-capable-groq-model
GEMINI_ORCHESTRATOR_MODEL=configure-a-text-capable-gemini-model
GROQ_ORCHESTRATOR_MODEL=configure-a-text-capable-groq-model
GEMINI_VERIFICATION_MODEL=configure-a-vision-capable-gemini-model
GROQ_VERIFICATION_MODEL=configure-a-vision-capable-groq-model
OPENROUTER_TIMEOUT_SECONDS=30
